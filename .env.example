# Copy to .env and fill in. On AWS, set these as environment variables / secrets instead.

# --- AI models (each user adds their own Gemini API key in the app: Account → API keys) ---
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
QUESTIONS_PER_INTERVIEW=5
# 1 = stream the server machine's webcam at /video_feed (local use only).
# Use 0 when deployed (e.g. AWS): the browser's own camera is used instead.
ENABLE_SERVER_CAMERA=1

# --- Database (local: docker compose up -d; AWS: your RDS Postgres URL) ---
POSTGRES_USER=coach
POSTGRES_PASSWORD=change-me
POSTGRES_DB=interview_coach
POSTGRES_PORT=5434
DATABASE_URL=postgresql://coach:change-me@127.0.0.1:5434/interview_coach

# --- Security ---
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# Encrypts users' Gemini API keys in the database. Generate once and keep it safe (e.g. AWS Secrets
# Manager); changing it makes stored keys unreadable.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# 1 when the site is served over HTTPS (production)
SESSION_HTTPS_ONLY=0

# --- Email for password reset (any SMTP server; on AWS use SES SMTP credentials) ---
# Without SMTP_HOST, reset links are printed in the server log instead.
APP_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Interview Coach <no-reply@example.com>
SMTP_STARTTLS=1

# --- Speech-to-text (faster-whisper model: tiny.en, base.en, small.en, ...) ---
WHISPER_MODEL=base.en

# --- Admin panel: extra admin emails (comma-separated); or run: python -m coach.admin_cli make-admin EMAIL
ADMIN_EMAILS=
